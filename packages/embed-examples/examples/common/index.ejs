<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0, shrink-to-fit=no"
    />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta charset="UTF-8" />
    <style>
      body {
        height: 100vh;
        margin: 0px;
        padding: 0px;
        overflow: hidden;
        font-family: 'Roboto', sans-serif;
        position: relative;
      }

      html {
        height: 100vh;
      }

      #content {
        height: 100vh;
        background-color: #dadada;
      }

      /* ── Custom Dark Panel ── */
      #custom-panel {
        position: fixed;
        top: 0;
        right: -420px;
        width: 380px;
        height: 100vh;
        background-color: #1a1a1a;
        color: #ffffff;
        display: flex;
        flex-direction: column;
        z-index: 9999;
        transition: right 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: -4px 0 24px rgba(0,0,0,0.6);
      }

      #custom-panel.open {
        right: 0;
      }

      #custom-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px;
        border-bottom: 1px solid #333;
        background-color: #111;
        flex-shrink: 0;
      }

      #custom-panel-close {
        background: none;
        border: none;
        color: #aaa;
        font-size: 22px;
        cursor: pointer;
        line-height: 1;
        padding: 4px 8px;
        border-radius: 4px;
        transition: background 0.2s, color 0.2s;
      }

      #custom-panel-close:hover {
        background: #333;
        color: #fff;
      }

      #custom-panel-title {
        font-size: 15px;
        font-weight: 600;
        color: #fff;
        letter-spacing: 0.3px;
      }

      #custom-panel-body {
        flex: 1;
        overflow-y: auto;
        padding: 20px 18px;
      }

      #custom-panel-body::-webkit-scrollbar {
        width: 6px;
      }
      #custom-panel-body::-webkit-scrollbar-track {
        background: #1a1a1a;
      }
      #custom-panel-body::-webkit-scrollbar-thumb {
        background: #444;
        border-radius: 3px;
      }

      .panel-step-title {
        margin: 0 0 6px 0;
        font-size: 18px;
        font-weight: 700;
        padding-bottom: 10px;
        border-bottom-width: 2px;
        border-bottom-style: solid;
      }

      .panel-step-objective {
        font-size: 13px;
        color: #aaa;
        font-style: italic;
        margin-bottom: 18px;
        line-height: 1.5;
      }

      .panel-checklist {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .panel-checklist li {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 14px;
        font-size: 14px;
        line-height: 1.55;
        cursor: pointer;
      }

      .panel-checklist li input[type="checkbox"] {
        margin-top: 3px;
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        cursor: pointer;
        accent-color: #ffaa00;
      }
    </style>
    <script src="https://static.matterport.com/showcase-sdk/latest.js"></script>
  </head>

  <body>
    <div class="container">
      <iframe id="sdk-frame" allow="xr-spatial-tracking"></iframe>
    </div>
    <div id="text" class="hidden"></div>

    <!-- Custom Dark Panel -->
    <div id="custom-panel">
      <div id="custom-panel-header">
        <span id="custom-panel-title">Checklist</span>
        <button id="custom-panel-close" title="Cerrar">✕</button>
      </div>
      <div id="custom-panel-body"></div>
    </div>

    <script type="text/javascript" src="./bundle.js"></script>
  </body>
</html>
